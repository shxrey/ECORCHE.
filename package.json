    "test:unit": "tsx --test \"src/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:visual": "playwright test -c playwright.visual.config.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@vercel/analytics": "2.0.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@playwright/test": "1.65.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cheerio": "^1.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
