{
  "name": "hypertrophy-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "extract:legacy": "node scripts/extract-legacy.mjs",
    "verify:legacy": "tsx scripts/verify-legacy.tsx",
    "typecheck": "next typegen && tsc --noEmit",
